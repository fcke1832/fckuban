[run]
branch = True

source =
    banner
    birthdays
    calendar_matches
    fckuban
    links
    medialinks
    news
    partners
    seo
    team
    tickets
    tournaments
    translation

omit =
    */migrations/*
    */__pycache__/*
    */tests.py
    */test_settings.py
    manage.py
    main.py
    fckuban/wsgi.py
    venv/*
    .venv/*

[report]
precision = 2
show_missing = True
skip_covered = False
exclude_lines =
    pragma: no cover
    def __str__
    raise NotImplementedError
    if __name__ == .__main__.:

[html]
directory = htmlcov
